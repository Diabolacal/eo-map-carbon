    },
    {
      "id": "sub_count_60_vs_15",
      "title": "Subordinate count 60 -> 15",
      "changed_field": "swarm.alive (close_to_boss is the remainder bucket)",
      "accounting_notes": "alive must equal the range-bucket sum, so close_to_boss is the accounting remainder. medium_range and detached_far stay 8 and 5."
    },
    {
      "id": "detached_5_vs_35",
      "title": "Detached subordinates 5 -> 35",
      "changed_field": "swarm.detached_far (close_to_boss is the remainder bucket)",
      "accounting_notes": "alive stays 45 and medium_range stays 8. close_to_boss falls because buckets must sum to alive."
    },
    {
      "id": "losses_2_vs_20",
      "title": "Recent subordinate losses 2 -> 20",
      "changed_field": "swarm.losses_last_10s (losses_last_30s stays >= 10s losses)",
      "accounting_notes": "losses_last_30s cannot be smaller than losses_last_10s, so both rise together. alive is unchanged; this is a recent-loss pulse, not a new headcount."
    },
    {
      "id": "reinforce_unavailable_vs_available",
      "title": "Reinforcement unavailable -> available under pressure",
      "changed_field": "boss.reinforcement_capacity_available",
      "accounting_notes": "Both sides use the same pressured mid-fight snapshot. Only capacity and cooldown change."
    },
    {
      "id": "p3_boss_damage_50_vs_800",
      "title": "P3 recent boss damage 50 -> 800",
      "changed_field": "players[P3].damage_to_boss_last_10s",
      "accounting_notes": "Only P3's recent boss damage changes. boss.damage_received_last_10s and derived top-damager fields are recomputed from the player list so the snapshot stays consistent."
    },
    {
      "id": "hostile_distance_20_vs_150",
      "title": "Hostile distance 20 km -> 150 km",
      "changed_field": "all alive players' distance_from_boss_km",
      "accounting_notes": "Every alive player is placed at 20 km or 150 km. Damage stays fixed so the only tactical change is range (and toward/away on the far side, because 150 km hostiles are not approaching)."
    }
