Texture2D sceneTex : register(t0);
Texture2D bloomTex : register(t1);
SamplerState sampl : register(s0);

cbuffer cb0 : register(b0)
{
	float threshold;
	float strength;
	float radius;
	float exposure;
	float texelX;
	float texelY;
	float blurDirX;
	float blurDirY;
};

struct VS_OUTPUT
{
	float4 Position : SV_Position;
	float2 TexCoord : TEXCOORD;
};

float4 main(VS_OUTPUT input) : SV_Target
{
	float3 scene = sceneTex.Sample(sampl, input.TexCoord).rgb;
	float3 bloom = bloomTex.Sample(sampl, input.TexCoord).rgb;
	float3 hdr = (scene + bloom * strength) * max(exposure, 0.01);
	// Luminance Reinhard keeps channel ratios. Per-channel Reinhard plus HDR
	// emissive was collapsing cool/warm stars onto white.
	float lum = dot(hdr, float3(0.2126, 0.7152, 0.0722));
	float mappedLum = lum / (1.0 + lum * 0.35);
	float3 mapped = hdr * (mappedLum / max(lum, 1e-5));
	float peak = max(mapped.r, max(mapped.g, mapped.b));
	mapped *= (peak > 1.0) ? (1.0 / peak) : 1.0;
	return float4(mapped, 1.0);
}
